<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Speak Selected"
           Manufacturer="Josh"
           Version="1.0.1"
           UpgradeCode="f4848f10-d825-41e1-8999-9c9e8e0722be"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Speak Selected is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.PayloadDir)\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Autostart is NOT set here. The app's own Settings has a user-facing
         "Run at startup" checkbox (autostart.py) that writes this same
         HKCU Run-key value directly — if the installer also owned that
         value as a component KeyPath, a user who turned autostart off
         would have it silently rewritten back on the next repair or
         version upgrade, overriding their own explicit choice. The app
         sets it once itself, on first run only (see main()'s onboarding
         block) — fully outside MSI's component tracking, so it's never
         reset by anything other than the user's own toggle. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="APPFOLDER" Name="SpeakSelected" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="PayloadFiles" Directory="APPFOLDER">
      <Files Include="$(var.PayloadDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="7e2a1f4c-9b6d-4e2a-8c1f-3d9a6b2e4f17">
        <Shortcut Id="SpeakSelectedShortcut" Name="Speak Selected"
                  Target="[APPFOLDER]SpeakSelected.exe" WorkingDirectory="APPFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="RemoveProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SpeakSelected" Name="installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentGroupRef Id="PayloadFiles" />
    </Feature>

  </Package>
</Wix>
